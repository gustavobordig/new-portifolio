# ---- Turso (banco das métricas) ----
# turso db create space-portfolio
# turso db show space-portfolio --url
# turso db tokens create space-portfolio
TURSO_DATABASE_URL=libsql://seu-banco.turso.io
TURSO_AUTH_TOKEN=

# ---- Admin (gere com: node scripts/admin-credentials.mjs) ----
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ADMIN_AUTH_SECRET=

# Opcional: desliga a coleta no cliente (útil em dev)
# NEXT_PUBLIC_DISABLE_ANALYTICS=1
